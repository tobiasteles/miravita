+}
+.fx-shake { animation: fx-shake 0.3s linear; }
+.fx-shake-big { --fx-amp: 10px; animation: fx-shake 0.4s linear; }
+.fx-flash { position: absolute; inset: 0; animation: fx-flash 0.35s ease-out forwards; }
