+}
+@keyframes fx-fade { 0% { opacity: 0; } 15%, 85% { opacity: 1; } 100% { opacity: 0; } }
+@keyframes fx-shake {
+  20% { transform: translate(calc(var(--fx-amp, 5px) * -1), 2px); }
