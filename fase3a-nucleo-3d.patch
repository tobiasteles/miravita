@@ -0,0 +1,28 @@
+import { createContext, useContext } from "react";
+import type { Group, MeshBasicMaterial, Vector3 } from "three";
+
+export type Off = { x: number; y: number; sx: number; sy: number; rot: number; op: number; fr: number; fg: number; fb: number };
+export const newOff = (): Off => ({ x: 0, y: 0, sx: 1, sy: 1, rot: 0, op: 1, fr: 0, fg: 0, fb: 0 });
+export type ActorRef = {
+  g: Group; m: MeshBasicMaterial; home: Vector3; h: number; w: number;
+  off: Off; // deslocamentos do quadro atual (o Director zera e soma a cada frame)
+  hold: { op: number; y: number; rot: number }; // estado que fica depois de vitória/derrota
+};
+export type BurstOpts = { x: number; y: number; z: number; color: string; n: number; mode?: "burst" | "ring" | "rise"; speed?: number; life?: number; gravity?: number; spread?: number };
+export type Stage = {
+  // posição em % do quadro (como o resto do jogo: SPOTS, CSS) → unidades do mundo, em qualquer profundidade z
+  at: (xPct: number, yPct: number, z?: number) => [number, number, number];
+  vis: (z?: number) => { w: number; h: number };
+  actors: Map<string, ActorRef>;
+  shake: { amp: number };
+  busy: { n: number };
+  visible: { v: boolean };
+  fx: { burst: (o: BurstOpts) => void };
+  invalidate: () => void;
+};
+export const StageCtx = createContext<Stage | null>(null);
+export function useStage(): Stage {
+  const s = useContext(StageCtx);
+  if (!s) throw new Error("useStage: use dentro de <GameStage>");
+  return s;
+}
diff --git a/src/components/stage/core/director.tsx b/src/components/stage/core/director.tsx
new file mode 100644
index 0000000..e8c3773
--- /dev/null
+++ b/src/components/stage/core/director.tsx
@@ -0,0 +1,140 @@
+"use client";
+import { useFrame } from "@react-three/fiber";
+import { useEffect, useRef } from "react";
+import { Color } from "three";
+import type { StageBus, StageEvent, Who } from "../bus";
+import { fxColor } from "../colors";
+import { useStage, type ActorRef } from "./context";
+
+// Recebe eventos do servidor (via bus) e vira animações curtas (tweens) sobre os atores. Só desenha: nunca decide nada.
+type Tw = { t: number; dur: number; step: (p: number) => void; done?: () => void };
+const ease = (p: number) => 1 - (1 - p) ** 3;
+const bell = (p: number) => Math.sin(Math.PI * p);
+const back = (p: number) => 1 + 2.70158 * (p - 1) ** 3 + 1.70158 * (p - 1) ** 2;
+
+export function Director({ bus }: { bus: StageBus }) {
+  const st = useStage();
+  const tws = useRef<Tw[]>([]);
+  const dirty = useRef(false);
+
+  useEffect(() => {
+    const list = tws.current;
+    const add = (delay: number, dur: number, step: (p: number) => void, done?: () => void) =>
+      list.push({ t: -delay, dur: Math.max(dur, 0.001), step, done });
+    const at = (delay: number, fn: () => void) => add(delay, 0.001, () => {}, fn);
+    const act = (w: Who) => st.actors.get(w);
+    // o ator pode montar um pouco depois do evento (a cena 3D renderiza em outro ciclo): tenta de novo por ~0,5 s
+    const later = (w: Who, fn: (a: ActorRef) => void, tries = 10) => {
+      const a = act(w);
+      if (a) fn(a);
+      else if (tries > 0) setTimeout(() => later(w, fn, tries - 1), 50);
+    };
+    const mid = (a: ActorRef) => ({ x: a.g.position.x, y: a.home.y + a.h * 0.5, z: a.home.z + 0.3 });
+    const flash = (a: ActorRef, c: Color, delay: number, dur: number) =>
+      add(delay, dur, (p) => { const f = 1 - p; a.off.fr += (c.r * 0.8 + 0.4) * f; a.off.fg += (c.g * 0.8 + 0.4) * f; a.off.fb += (c.b * 0.8 + 0.4) * f; });
+
+    const strike = (e: Extract<StageEvent, { k: "hit" | "crit" | "dodge" }>) => {
+      const A = act(e.from), T = act(e.to), crit = e.k === "crit", miss = e.k === "dodge";
+      const hex = fxColor("el" in e ? e.el : undefined), col = new Color(hex);
+      if (A && T) {
+        const reach = (T.home.x - A.home.x) * 0.45; // avanço do atacante em direção ao alvo e volta
+        add(0, 0.4, (p) => { const f = p < 0.35 ? ease(p / 0.35) : 1 - ease((p - 0.35) / 0.65); A.off.x += reach * f; A.off.sx *= 1 + 0.06 * f; });
+      }
+      if (!T) return;
+      const dir = A ? Math.sign(T.home.x - A.home.x) || 1 : 1, lag = 0.14;
+      if (miss) {
+        add(lag, 0.5, (p) => { const f = bell(p); T.off.x += dir * 0.9 * f; T.off.y += 0.12 * f; T.off.op *= 1 - 0.5 * f; });
+        return;
+      }
+      add(lag, crit ? 0.55 : 0.38, (p) => { const f = (1 - p) ** 2; T.off.x += dir * (crit ? 0.9 : 0.45) * f; T.off.sy *= 1 - (crit ? 0.16 : 0.08) * f; T.off.sx *= 1 + (crit ? 0.1 : 0.05) * f; });
+      flash(T, crit ? col : new Color("#ffffff"), lag, crit ? 0.3 : 0.18);
+      at(lag, () => {
+        const m = mid(T);
+        st.fx.burst({ ...m, color: hex, n: crit ? 36 : 14, speed: crit ? 3.2 : 2.2, life: 0.6, gravity: 3 });
+        if (crit) st.fx.burst({ ...m, color: "#ffffff", n: 10, speed: 4, life: 0.35, gravity: 0 });
+        st.shake.amp = Math.max(st.shake.amp, crit ? 0.35 : 0.12);
+      });
+    };
+
+    const handle = (e: StageEvent) => {
+      switch (e.k) {
+        case "hit": case "crit": case "dodge": strike(e); break;
+        case "heal": {
+          const T = act(e.to);
+          if (!T) break;
+          add(0, 0.6, (p) => { const f = bell(p); T.off.sx *= 1 + 0.04 * f; T.off.sy *= 1 + 0.04 * f; T.off.fg += 0.5 * f; T.off.fr += 0.15 * f; T.off.fb += 0.2 * f; });
+          at(0, () => st.fx.burst({ x: T.g.position.x, y: T.home.y + T.h * 0.2, z: T.home.z + 0.3, color: "#34d399", n: 22, mode: "rise", speed: 1.6, life: 0.9, gravity: -0.5, spread: T.w * 0.35 }));
+          break;
+        }
+        case "skill": {
+          const A = act(e.from);
+          if (!A) break;
+          const hex = fxColor(e.el, "#a78bfa"), c = new Color(hex);
+          add(0, 0.5, (p) => { const f = bell(p); A.off.sx *= 1 + 0.1 * f; A.off.sy *= 1 + 0.1 * f; A.off.fr += c.r * 0.6 * f; A.off.fg += c.g * 0.6 * f; A.off.fb += c.b * 0.6 * f; });
+          at(0.1, () => st.fx.burst({ ...mid(A), color: hex, n: 28, mode: "ring", speed: 2.6, life: 0.6, gravity: 0 }));
+          break;
+        }
+        case "summon":
+          later("summon", (S) => {
+            add(0, 0.5, (p) => { const s = back(p); S.off.sx *= s; S.off.sy *= s; S.off.op *= Math.min(1, p * 3); });
+            at(0, () => st.fx.burst({ ...mid(S), color: fxColor(e.el, "#67e8f9"), n: 26, mode: "ring", speed: 2.2, life: 0.6, gravity: 0 }));
+          });
+          break;
+        case "win": {
+          const F = act("foe"), M = act("me");
+          if (F) {
+            add(0.1, 0.9, (p) => { const f = ease(p); F.off.op *= 1 - f; F.off.y += 0.5 * f; F.off.sx *= 1 - 0.2 * f; F.off.sy *= 1 - 0.2 * f; }, () => { F.hold.op = 0; });
+            at(0.1, () => st.fx.burst({ ...mid(F), color: "#fbbf24", n: 44, speed: 3, life: 0.9, gravity: 2.5 }));
+          }
+          if (M) add(0.2, 0.7, (p) => { M.off.y += Math.abs(Math.sin(p * Math.PI * 2)) * 0.5 * (1 - p); });
+          break;
+        }
+        case "lose": {
+          const M = act("me");
+          if (!M) break;
+          add(0, 0.8, (p) => { const f = ease(p); M.off.y -= 0.35 * f; M.off.rot += 0.5 * f; M.off.op *= 1 - 0.65 * f; M.off.fr += 0.5 * (1 - p); }, () => { M.hold = { op: 0.35, y: -0.35, rot: 0.5 }; });
+          at(0, () => { st.shake.amp = Math.max(st.shake.amp, 0.3); st.fx.burst({ ...mid(M), color: "#f43f5e", n: 24, speed: 2, life: 0.8, gravity: 2 }); });
+          break;
+        }
+        case "flee": {
+          const M = act("me");
+          if (!M) break;
+          const dx = st.vis(M.home.z).w * 0.3;
+          add(0, 0.7, (p) => { const f = ease(p); M.off.x -= dx * f; M.off.op *= 1 - f; }, () => { M.hold.op = 0; });
+          break;
+        }
+      }
+      dirty.current = true;
+      st.invalidate();
+    };
+    const off = bus.on(handle);
+    return () => { off(); list.length = 0; };
+  }, [bus, st]);
+
+  useFrame((_, dtRaw) => {
+    const list = tws.current;
+    if (!list.length && !dirty.current) { st.busy.n = 0; return; }
+    const dt = Math.min(dtRaw, 0.05);
+    st.actors.forEach((a) => { const o = a.off; o.x = o.y = o.rot = o.fr = o.fg = o.fb = 0; o.sx = o.sy = o.op = 1; });
+    for (let i = list.length - 1; i >= 0; i--) {
+      const w = list[i];
+      w.t += dt;
+      if (w.t < 0) continue;
+      const p = Math.min(1, w.t / w.dur);
+      w.step(p);
+      if (p >= 1) { w.done?.(); list.splice(i, 1); }
+    }
+    st.actors.forEach((a) => {
+      const o = a.off;
+      a.g.position.set(a.home.x + o.x, a.home.y + o.y + a.hold.y, a.home.z);
+      a.g.scale.set(o.sx, o.sy, 1);
+      a.g.rotation.z = o.rot + a.hold.rot;
+      a.m.opacity = o.op * a.hold.op;
+      a.m.color.setRGB(1 + o.fr, 1 + o.fg, 1 + o.fb);
+    });
+    dirty.current = list.length > 0;
+    st.busy.n = list.length;
+    if (list.length) st.invalidate();
+  });
+  return null;
+}
diff --git a/src/components/stage/core/layers.tsx b/src/components/stage/core/layers.tsx
new file mode 100644
index 0000000..1ad9679
--- /dev/null
+++ b/src/components/stage/core/layers.tsx
@@ -0,0 +1,110 @@
+"use client";
+import { useFrame } from "@react-three/fiber";
+import { useEffect, useMemo, useRef } from "react";
+import { CanvasTexture, Color, DoubleSide, SRGBColorSpace, Vector3 } from "three";
+import type { Group, MeshBasicMaterial } from "three";
+import { newOff, useStage, type ActorRef } from "./context";
+import { useTex } from "./textures";
+
+// Camadas da cena. Posições em % do quadro (iguais às do layout 2D) + profundidade z (negativo = mais longe).
+
+// fundo: cobre a tela inteira com a textura (como background-size: cover) e sobra um pouco para o movimento de câmera
+export function Backdrop({ urls, z = -8, dim = 1, tint = "#ffffff", overscan = 1.1 }: { urls: readonly string[]; z?: number; dim?: number; tint?: string; overscan?: number }) {
+  const st = useStage();
+  const tex = useTex(urls);
+  const color = useMemo(() => new Color(tint).multiplyScalar(dim), [tint, dim]);
+  if (!tex) return null;
+  const img = tex.image as { width: number; height: number };
+  const ia = img.width / img.height, v = st.vis(z);
+  let h = v.h * overscan, w = h * ia;
+  if (w < v.w * overscan) { w = v.w * overscan; h = w / ia; }
+  return (
+    <mesh position={[0, 0, z]} renderOrder={0}>
+      <planeGeometry args={[w, h]} />
+      <meshBasicMaterial map={tex} color={color} toneMapped={false} />
+    </mesh>
+  );
+}
+
+// película de cor por cima da cena (noite, perigo, derrota). Fica perto da câmera e cobre tudo.
+export function Tint({ color, opacity, z = 6 }: { color: string; opacity: number; z?: number }) {
+  const st = useStage();
+  if (opacity <= 0) return null;
+  const v = st.vis(z);
+  return (
+    <mesh position={[0, 0, z]} renderOrder={30}>
+      <planeGeometry args={[v.w * 1.3, v.h * 1.3]} />
+      <meshBasicMaterial color={color} transparent opacity={opacity} depthWrite={false} toneMapped={false} />
+    </mesh>
+  );
+}
+
+let shadowTex: CanvasTexture | null = null;
+function getShadowTex() {
+  if (!shadowTex) {
+    const c = document.createElement("canvas");
+    c.width = c.height = 64;
+    const g = c.getContext("2d");
+    if (g) {
+      const r = g.createRadialGradient(32, 32, 0, 32, 32, 32);
+      r.addColorStop(0, "rgba(0,0,0,.85)"); r.addColorStop(1, "rgba(0,0,0,0)");
+      g.fillStyle = r; g.fillRect(0, 0, 64, 64);
+    }
+    shadowTex = new CanvasTexture(c);
+    shadowTex.colorSpace = SRGBColorSpace;
+  }
+  return shadowTex;
+}
+// sombra "blob": uma elipse escura sob os pés (sem shadow map, quase de graça)
+export function Shadow({ x, y, z, w, opacity = 0.55 }: { x: number; y: number; z: number; w: number; opacity?: number }) {
+  const t = getShadowTex();
+  return (
+    <mesh position={[x, y + w * 0.04, z - 0.02]} renderOrder={3}>
+      <planeGeometry args={[w, w * 0.28]} />
+      <meshBasicMaterial map={t} transparent opacity={opacity} depthWrite={false} toneMapped={false} />
+    </mesh>
+  );
+}
+
+// personagem/monstro: arte 2D existente num plano, com os pés ancorados em (x%, y%)
+export function Actor({ id, urls, x, y, z = 0, h, flip = false, shadow = true, bob = true }: { id: string; urls: readonly string[]; x: number; y: number; z?: number; h: number; flip?: boolean; shadow?: boolean; bob?: boolean }) {
+  const st = useStage();
+  const tex = useTex(urls);
+  const g = useRef<Group>(null), breath = useRef<Group>(null), mat = useRef<MeshBasicMaterial>(null);
+  const hh = (h / 100) * st.vis(z).h;
+  const img = tex?.image as { width: number; height: number } | undefined;
+  const ww = img ? hh * (img.width / img.height) : hh * 0.8;
+  const [X, Y] = st.at(x, y, z);
+  const phase = useMemo(() => Math.random() * 6, []);
+
+  useEffect(() => {
+    if (!g.current || !mat.current) return;
+    const ref: ActorRef = { g: g.current, m: mat.current, home: new Vector3(X, Y, z), h: hh, w: ww, off: newOff(), hold: { op: 1, y: 0, rot: 0 } };
+    st.actors.set(id, ref);
+    return () => { if (st.actors.get(id) === ref) st.actors.delete(id); };
+  }, [st, id, X, Y, z, hh, ww]);
+
+  useFrame(({ clock }) => { // respiração leve (só roda enquanto a cena anima)
+    if (bob && breath.current) breath.current.scale.y = 1 + 0.012 * Math.sin(clock.elapsedTime * 2 + phase);
+  });
+
+  return (
+    <>
+      {shadow && <Shadow x={X} y={Y} z={z} w={ww * 0.8} />}
+      <group ref={g} position={[X, Y, z]}>
+        <group ref={breath}>
+          <mesh position={[0, hh / 2, 0]} scale={[flip ? -1 : 1, 1, 1]} renderOrder={5} visible={!!tex}>
+            <planeGeometry args={[ww, hh]} />
+            <meshBasicMaterial ref={mat} map={tex} transparent depthWrite={false} toneMapped={false} side={DoubleSide} />
+          </mesh>
+          {urls.length === 0 && ( // sem arte: silhueta simples, para a cena continuar funcionando
+            <mesh position={[0, hh / 2, 0]} renderOrder={5}>
+              <circleGeometry args={[hh * 0.3, 24]} />
+              <meshBasicMaterial color="#6d28d9" transparent opacity={0.4} depthWrite={false} toneMapped={false} />
+            </mesh>
+          )}
+        </group>
+      </group>
+    </>
+  );
+}
