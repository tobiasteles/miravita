DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
AUTH_SECRET=         # OBRIGATÓRIO: string aleatória de 32+ caracteres (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
XP_MULTIPLIER=1   # use 30 para testar rápido; 1 = ritmo real de ~120 dias
GEMINI_API_KEY=       # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3-flash-preview
CRON_SECRET=          # string aleatória longa; a Vercel envia no header do cron
ADMIN_EMAILS=        # emails dos administradores, separados por vírgula
ADMIN_USER_IDS=      # (opcional) ids de usuário, separados por vírgula
